# Required: bearer token clients send as `Authorization: Bearer <token>`.
MCP_GATEWAY_TOKEN=

# Supabase server (skipped when SUPABASE_ACCESS_TOKEN is unset).
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
SUPABASE_FEATURES=database,debugging,development,docs,functions,branching

# GitHub server (skipped when GITHUB_PERSONAL_ACCESS_TOKEN is unset).
GITHUB_PERSONAL_ACCESS_TOKEN=
GH_TOKEN=

# Runtime (these defaults are also baked into the Dockerfile).
PORT=8080
LOG_LEVEL=info
MCP_DATA_DIR=/data
MCP_ROOT=/app
MCP_PYBIN=/opt/pyenv/bin
PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
NODE_ENV=production

# Optional knobs read by gateway/src/servers.js and gateway/src/index.js:
# MCP_DISABLED_SERVERS=everything,harvest
# MCP_ENABLE_EVERYTHING=1
# MCP_CORS_ORIGIN=
# MCP_SESSION_IDLE_MS=7200000
# MCP_MAX_SESSIONS=1000
# PLAYWRIGHT_PROXY_SERVER=
# HARVEST_PROXY=
# FETCH_USER_AGENT=
# TZ=

# Server-side Maps tile runs (gateway/src/tile-run.js; need supabase + harvest):
# TILE_RUN_CRON=0 */3 * * *        # America/Chicago; unset = no schedule
# TILE_RUN_MAX_SEARCHES=30         # per scheduled run, and the start_tile_run default
# TILE_RUN_MAX_MINUTES=45          # wall-clock cap per run
# TILE_RUN_MAX_ZOOM=15             # capped areas are split down to this zoom (14-17)
# TILE_RUN_SPLIT_MIN_NEW=1         # below 13z, split a capped area only if it found this many new leads
# HARVEST_MAX_CALLS=500            # Maps calls per budget window
# HARVEST_BUDGET_WINDOW_S=86400    # rolling budget window
# HARVEST_CIRCUIT_RESET_S=7200     # circuit breaker closes again after this
